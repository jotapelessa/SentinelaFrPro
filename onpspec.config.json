{
  "testCommand": "node --test --test-reporter tap test/*.test.js",
  "reporter": "tap",
  "testGlobs": [
    "test/**",
    "backend/tests/**",
    "frontend/tests/**",
    "frontend/src/**/*.test.*",
    "android/app/src/test/**"
  ],
  "srcGlobs": [
    "backend/app/**",
    "frontend/src/**",
    "android/app/src/main/**"
  ]
}
